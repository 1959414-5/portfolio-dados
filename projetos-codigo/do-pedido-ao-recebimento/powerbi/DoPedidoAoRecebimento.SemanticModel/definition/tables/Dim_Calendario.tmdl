	partition Dim_Calendario = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaDados & "dim_calendario.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Cabecalho, {{"Data", type date}, {"Ano", Int64.Type}, {"MesNum", Int64.Type}, {"NomeMes", type text}, {"MesAno", type text}, {"AnoMes", Int64.Type}, {"Trimestre", type text}, {"DiaSemana", type text}}, "en-US")
				in
				    Tipos
